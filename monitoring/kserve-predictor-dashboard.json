{
 "uid": "kserve-predictor",
 "title": "KServe Predictor",
 "tags": [
  "kserve",
  "ch11"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "30s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "job",
    "label": "InferenceService",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(request_predict_seconds_count, job)",
     "refId": "A"
    },
    "refresh": 2,
    "current": {
     "text": "pets-yolov8n",
     "value": "pets-yolov8n"
    }
   }
  ]
 },
 "panels": [
  {
   "type": "stat",
   "title": "수집 상태 (up)",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "DOWN",
         "color": "red"
        },
        "1": {
         "text": "UP",
         "color": "green"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "up{job=\"$job\"}",
     "legendFormat": "{{pod}}",
     "refId": "A"
    }
   ],
   "id": 1
  },
  {
   "type": "gauge",
   "title": "Pet 탐지 신뢰도 p90 (최근 5분)",
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "min": 0,
     "max": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "yellow",
        "value": 0.5
       },
       {
        "color": "green",
        "value": 0.8
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.9, sum(rate(pet_confidence_score_bucket[5m])) by (le))",
     "refId": "A"
    }
   ],
   "id": 2
  },
  {
   "type": "timeseries",
   "title": "추천 요청: top_k 를 준 요청과 기본값 요청 (5분 증가량)",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (top_k) (increase(reco_top_k_requests_total{job=~\"reco-kserve.*\"}[5m]))",
     "legendFormat": "{{top_k}}",
     "refId": "A"
    }
   ],
   "id": 3
  },
  {
   "type": "timeseries",
   "title": "초당 요청 수",
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 12,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(request_predict_seconds_count{job=\"$job\"}[5m]))",
     "legendFormat": "predict",
     "refId": "A"
    }
   ],
   "id": 4
  },
  {
   "type": "timeseries",
   "title": "추론 지연 시간",
   "gridPos": {
    "x": 12,
    "y": 5,
    "w": 12,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.5, sum(rate(request_predict_seconds_bucket{job=\"$job\"}[5m])) by (le))",
     "legendFormat": "p50",
     "refId": "A"
    },
    {
     "expr": "histogram_quantile(0.9, sum(rate(request_predict_seconds_bucket{job=\"$job\"}[5m])) by (le))",
     "legendFormat": "p90",
     "refId": "B"
    }
   ],
   "id": 5
  },
  {
   "type": "timeseries",
   "title": "CPU 사용량 (코어)",
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"kubeflow-user-example-com\", pod=~\"$job-predictor.*\", container=\"kserve-container\"}[5m]))",
     "legendFormat": "사용",
     "refId": "A"
    },
    {
     "expr": "sum(kube_pod_container_resource_limits{namespace=\"kubeflow-user-example-com\", pod=~\"$job-predictor.*\", container=\"kserve-container\", resource=\"cpu\"})",
     "legendFormat": "제한",
     "refId": "B"
    }
   ],
   "id": 6
  },
  {
   "type": "timeseries",
   "title": "메모리 사용량",
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(container_memory_working_set_bytes{namespace=\"kubeflow-user-example-com\", pod=~\"$job-predictor.*\", container=\"kserve-container\"})",
     "legendFormat": "사용",
     "refId": "A"
    },
    {
     "expr": "sum(kube_pod_container_resource_limits{namespace=\"kubeflow-user-example-com\", pod=~\"$job-predictor.*\", container=\"kserve-container\", resource=\"memory\"})",
     "legendFormat": "제한",
     "refId": "B"
    }
   ],
   "id": 7
  },
  {
   "type": "timeseries",
   "title": "Pet 탐지 수 (클래스별, 5분 증가량)",
   "gridPos": {
    "x": 0,
    "y": 19,
    "w": 12,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (class_name) (increase(pet_detections_total[5m]))",
     "legendFormat": "{{class_name}}",
     "refId": "A"
    },
    {
     "expr": "sum(increase(pet_images_without_detection_total[5m]))",
     "legendFormat": "탐지 없음",
     "refId": "B"
    }
   ],
   "id": 8
  },
  {
   "type": "timeseries",
   "title": "추천 요청 거부 (사유별, 5분 증가량)",
   "gridPos": {
    "x": 12,
    "y": 19,
    "w": 12,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (reason) (increase(reco_rejected_requests_total[5m]))",
     "legendFormat": "{{reason}}",
     "refId": "A"
    }
   ],
   "id": 9
  }
 ]
}